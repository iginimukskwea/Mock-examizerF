# ===== AI provider (optional) =====
# Without any API key the app runs in DEMO mode: deterministic heuristic
# extraction / generation so every screen and the PDF pipeline still work.

# OpenAI-compatible server (recommended)
# Examples:
#   OpenAI:    AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
#   vLLM:      AI_BASE_URL=http://<server>:8000/v1    AI_MODEL=<served-model>
#   LM Studio: AI_BASE_URL=http://localhost:1234/v1   AI_MODEL=<model-id>
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Leave empty to auto-discover the first model from /v1/models.
AI_MODEL=gpt-4o-mini

# One AI request timeout in milliseconds. Values above 600000 are capped.
AI_TIMEOUT_MS=300000

# Optional: Anthropic Claude (used only when OPENAI_API_KEY is empty)
ANTHROPIC_API_KEY=
# AI_MODEL for Anthropic (defaults to claude-sonnet-4-5)
# AI_MODEL=claude-sonnet-4-5

# ===== Deterministic solver (optional) =====
# Step A uses Python+SymPy when available, otherwise falls back to Node.js.
# No configuration is needed; detection is automatic.

# ===== Local OCR (scanned PDF / image) =====
# tesseract.js (jpn + eng) is used automatically when a PDF has no embedded text.
# Language data is bundled by @tesseract.js-data/* and copied to data/tessdata.
# Optional: project-local Python OCR environment (see README).
# PYTHON_OCR_PYTHON=C:/path/to/.venv-ocr/Scripts/python.exe

# ===== PDF rendering =====
# Chrome/Edge executable used by puppeteer-core. Auto-detected when empty.
CHROME_PATH=
